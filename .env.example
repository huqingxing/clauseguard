# ClauseGuard 本地环境变量模板。复制为 .env 后改成你的本地值（.env 已 gitignore 风格，勿提交真实密钥）。
# 复制命令：cp .env.example .env

# ---- MySQL（业务库）----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=clauseguard
MYSQL_USER=clauseguard
MYSQL_PASSWORD=clauseguard

# ---- PostgreSQL（agent 运行态 / 向量）----
POSTGRES_DB=clauseguard_agent
POSTGRES_USER=clauseguard
POSTGRES_PASSWORD=clauseguard

# ---- 检索库（pgvector，端口 55432 的那个实例）----
# 密码只能放这里：config/retrieval.yaml 会提交进仓库，不写密码。
# 优先级 环境变量 > .env > yaml，整串给出会完整覆盖 yaml 里的 DSN（含密码）。
CLAUSEGUARD_RETRIEVAL_PG_DSN=postgresql://clauseguard:clauseguard@127.0.0.1:55432/clauseguard_retrieval?connect_timeout=2

# ---- Redis ----
# 无鉴权，仅本地使用

# ---- MinIO（合同对象存储）----
MINIO_ROOT_USER=clauseguard
MINIO_ROOT_PASSWORD=clauseguard123
MINIO_BUCKET=contracts

# ---- LLM Provider（Python 编排侧使用；密钥仅放 .env，绝不进代码）----
LLM_PROVIDER=dashscope
LLM_API_KEY=

# ---- 运行约束（Python 编排侧读取，用于熔断与成本控制）----
# 并行审查的条款/专家并发上限
CONCURRENCY_LIMIT=4
# 单次审查最大 token 预算
MAX_TOKENS=8192
# 单次审查最大花费（人民币元），超阈值熔断
MAX_COST_CNY=5.0
