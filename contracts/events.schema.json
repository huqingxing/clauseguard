{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clauseguard.local/contracts/events.schema.json",
  "title": "ClauseGuard SSE Events",
  "description": "Java <-> Python 跨服务 SSE 事件契约，JSON Schema 2020-12。所有事件共享公共字段 seq/ts/type，具体负载为各自的扁平字段；additionalProperties:false 硬约束禁止私加字段。本文件是事件结构的唯一事实源，任何一侧都不能手写字段漂移。",
  "oneOf": [
    { "$ref": "#/$defs/RunStarted" },
    { "$ref": "#/$defs/NodeStarted" },
    { "$ref": "#/$defs/NodeFinished" },
    { "$ref": "#/$defs/MessageDelta" },
    { "$ref": "#/$defs/ToolCall" },
    { "$ref": "#/$defs/ToolResult" },
    { "$ref": "#/$defs/Interrupt" },
    { "$ref": "#/$defs/RunCompleted" },
    { "$ref": "#/$defs/RunFailed" }
  ],
  "$defs": {
    "RunStarted": {
      "type": "object",
      "title": "run.started",
      "description": "一次审查运行开始。",
      "required": ["seq", "ts", "type", "run_id", "trace_id"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0, "description": "单调递增整数，由生产者保证，用于事件排序与去重。" },
        "ts": { "type": "string", "format": "date-time", "description": "RFC3339 事件发生时间，UTC。" },
        "type": { "type": "string", "const": "run.started", "description": "事件类型，点分小写。" },
        "run_id": { "type": "string", "description": "审查运行 ID，跨服务追踪主键。" },
        "trace_id": { "type": "string", "description": "链路追踪 ID，可与 run_id 解耦以支持 run 内多段 trace。" }
      },
      "additionalProperties": false,
      "examples": [
        { "seq": 1, "ts": "2026-10-22T10:00:00Z", "type": "run.started", "run_id": "run-0001", "trace_id": "trace-0001" }
      ]
    },
    "NodeStarted": {
      "type": "object",
      "title": "node.started",
      "description": "图节点（专家 Agent 或工具节点）开始执行。",
      "required": ["seq", "ts", "type", "node", "agent"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0, "description": "单调递增整数。" },
        "ts": { "type": "string", "format": "date-time", "description": "RFC3339 事件发生时间，UTC。" },
        "type": { "type": "string", "const": "node.started", "description": "事件类型，点分小写。" },
        "node": { "type": "string", "description": "图节点标识，如 split_clauses / review.liability。" },
        "agent": { "type": "string", "description": "执行该节点的专家 Agent 名，如 liability_expert。" }
      },
      "additionalProperties": false,
      "examples": [
        { "seq": 2, "ts": "2026-10-22T10:00:01Z", "type": "node.started", "node": "review.liability", "agent": "liability_expert" }
      ]
    },
    "NodeFinished": {
      "type": "object",
      "title": "node.finished",
      "description": "图节点执行结束，携带耗时与 token 用量。",
      "required": ["seq", "ts", "type", "node", "duration_ms", "tokens"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0, "description": "单调递增整数。" },
        "ts": { "type": "string", "format": "date-time", "description": "RFC3339 事件发生时间，UTC。" },
        "type": { "type": "string", "const": "node.finished", "description": "事件类型，点分小写。" },
        "node": { "type": "string", "description": "图节点标识。" },
        "duration_ms": { "type": "integer", "minimum": 0, "description": "节点执行耗时（毫秒）。" },
        "tokens": { "type": "integer", "minimum": 0, "description": "该节点累计消耗 token 数。" }
      },
      "additionalProperties": false,
      "examples": [
        { "seq": 3, "ts": "2026-10-22T10:00:04Z", "type": "node.finished", "node": "review.liability", "duration_ms": 3120, "tokens": 1840 }
      ]
    },
    "MessageDelta": {
      "type": "object",
      "title": "message.delta",
      "description": "流式增量文本片段，用于前端实时渲染专家输出。",
      "required": ["seq", "ts", "type", "agent", "text"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0, "description": "单调递增整数。" },
        "ts": { "type": "string", "format": "date-time", "description": "RFC3339 事件发生时间，UTC。" },
        "type": { "type": "string", "const": "message.delta", "description": "事件类型，点分小写。" },
        "agent": { "type": "string", "description": "产生该片段的 Agent。" },
        "text": { "type": "string", "description": "本次增量文本。" }
      },
      "additionalProperties": false,
      "examples": [
        { "seq": 4, "ts": "2026-10-22T10:00:02Z", "type": "message.delta", "agent": "liability_expert", "text": "该条款约定了违约金上限为" }
      ]
    },
    "ToolCall": {
      "type": "object",
      "title": "tool.call",
      "description": "Agent 调用工具（Java REST/MCP 封装或文档解析）。",
      "required": ["seq", "ts", "type", "agent", "tool", "args"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0, "description": "单调递增整数。" },
        "ts": { "type": "string", "format": "date-time", "description": "RFC3339 事件发生时间，UTC。" },
        "type": { "type": "string", "const": "tool.call", "description": "事件类型，点分小写。" },
        "agent": { "type": "string", "description": "调用方 Agent。" },
        "tool": { "type": "string", "description": "工具名，必须与 tools/ 中注册的一致。" },
        "args": { "type": "object", "additionalProperties": true, "description": "工具入参，结构由具体工具定义；开放字段以承载异构参数。" }
      },
      "additionalProperties": false,
      "examples": [
        { "seq": 5, "ts": "2026-10-22T10:00:02Z", "type": "tool.call", "agent": "liability_expert", "tool": "search_law_whitelist", "args": { "query": "违约金", "top_k": 5 } }
      ]
    },
    "ToolResult": {
      "type": "object",
      "title": "tool.result",
      "description": "工具返回结果，携带成功与否与延迟。",
      "required": ["seq", "ts", "type", "tool", "ok", "latency_ms"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0, "description": "单调递增整数。" },
        "ts": { "type": "string", "format": "date-time", "description": "RFC3339 事件发生时间，UTC。" },
        "type": { "type": "string", "const": "tool.result", "description": "事件类型，点分小写。" },
        "tool": { "type": "string", "description": "工具名。" },
        "ok": { "type": "boolean", "description": "工具是否成功执行。" },
        "latency_ms": { "type": "integer", "minimum": 0, "description": "工具执行延迟（毫秒）。" }
      },
      "additionalProperties": false,
      "examples": [
        { "seq": 6, "ts": "2026-10-22T10:00:02Z", "type": "tool.result", "tool": "search_law_whitelist", "ok": true, "latency_ms": 86 }
      ]
    },
    "Interrupt": {
      "type": "object",
      "title": "interrupt",
      "description": "图节点需要人工介入或外部输入而中断，运行态保留在 ReviewState，可恢复。",
      "required": ["seq", "ts", "type", "reason", "payload"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0, "description": "单调递增整数。" },
        "ts": { "type": "string", "format": "date-time", "description": "RFC3339 事件发生时间，UTC。" },
        "type": { "type": "string", "const": "interrupt", "description": "事件类型，点分小写。" },
        "reason": { "type": "string", "description": "中断原因，如 high_risk_pending_approval。" },
        "payload": { "type": "object", "additionalProperties": true, "description": "中断上下文，开放字段以承载任意待办快照。" }
      },
      "additionalProperties": false,
      "examples": [
        { "seq": 7, "ts": "2026-10-22T10:00:05Z", "type": "interrupt", "reason": "high_risk_pending_approval", "payload": { "clause_id": "c-12", "risk_level": "high" } }
      ]
    },
    "RunCompleted": {
      "type": "object",
      "title": "run.completed",
      "description": "审查运行完成，携带总用量与发现数。",
      "required": ["seq", "ts", "type", "usage", "findings_count"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0, "description": "单调递增整数。" },
        "ts": { "type": "string", "format": "date-time", "description": "RFC3339 事件发生时间，UTC。" },
        "type": { "type": "string", "const": "run.completed", "description": "事件类型，点分小写。" },
        "usage": {
          "type": "object",
          "description": "本次运行的总 token 用量与估算成本。",
          "required": ["input_tokens", "output_tokens", "cost_cny"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0, "description": "输入 token 数。" },
            "output_tokens": { "type": "integer", "minimum": 0, "description": "输出 token 数。" },
            "cost_cny": { "type": "number", "minimum": 0, "description": "估算成本（人民币元）。" }
          },
          "additionalProperties": false
        },
        "findings_count": { "type": "integer", "minimum": 0, "description": "汇总的审查发现条数。" }
      },
      "additionalProperties": false,
      "examples": [
        { "seq": 8, "ts": "2026-10-22T10:00:10Z", "type": "run.completed", "usage": { "input_tokens": 21000, "output_tokens": 4200, "cost_cny": 0.86 }, "findings_count": 17 }
      ]
    },
    "RunFailed": {
      "type": "object",
      "title": "run.failed",
      "description": "审查运行失败，携带错误码与可重试标记。",
      "required": ["seq", "ts", "type", "code", "message", "retryable"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0, "description": "单调递增整数。" },
        "ts": { "type": "string", "format": "date-time", "description": "RFC3339 事件发生时间，UTC。" },
        "type": { "type": "string", "const": "run.failed", "description": "事件类型，点分小写。" },
        "code": { "type": "string", "description": "机器可读错误码，如 LLM_TIMEOUT。" },
        "message": { "type": "string", "description": "人类可读错误描述。" },
        "retryable": { "type": "boolean", "description": "是否可安全重试。" }
      },
      "additionalProperties": false,
      "examples": [
        { "seq": 9, "ts": "2026-10-22T10:00:09Z", "type": "run.failed", "code": "LLM_TIMEOUT", "message": "upstream model timed out after 30s", "retryable": true }
      ]
    }
  }
}
