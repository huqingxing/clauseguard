# 依赖与构建产物
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Java
target/
*.class

# Node
node_modules/
dist/

# 密钥与本地环境（切勿提交）
.env
.env.local

# IDE
.idea/
.vscode/
*.iml

# 评测运行产物（baseline 入库供 CI 对比，其余为可重跑产物）
eval/out/*
!eval/out/metrics-baseline.json

# 演示合同由脚本生成（docx 是二进制、可复现，不入库）
deploy/demo/*.docx

# 本地上传的合同文件（运行时产物，Java 的 ./uploads）
java-service/uploads/

# 检索实验台的本地 pgvector 验收集群（独立端口 55432，可随时删除重建）
_pg_tmp/

# Python 字节码（lab/ 与 python-agent/ 各自 import 时都会生成）
__pycache__/
*.py[cod]

# 阶段 4 矩阵向量缓存（.npy 单个 label 约 130MB，可由 --label 重跑重建；
# report.md 与 metrics.json 是验收证据，保留可见）
lab/out/*/cache/
