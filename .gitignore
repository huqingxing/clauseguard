# 依赖与构建产物
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Java
target/
*.class

# Node
node_modules/
dist/

# 密钥与本地环境（切勿提交）
.env
.env.local

# IDE
.idea/
.vscode/
*.iml

# 评测运行产物（baseline 入库供 CI 对比，其余为可重跑产物）
eval/out/*
!eval/out/metrics-baseline.json

# 演示合同由脚本生成（docx 是二进制、可复现，不入库）
deploy/demo/*.docx
